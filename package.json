{
  "name": "discord2",
  "version": "2.0.0",
  "private": true,
  "description": "Servidores privados, compartilhamento de tela em alta resolucao e anotacoes ao vivo",
  "author": "Spike",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build": "npm run icon && node scripts/prep-build.js && electron-builder",
    "portable": "npm run icon && node scripts/pack-portable.js",
    "cert": "node scripts/gen-cert.js",
    "icon": "node scripts/gen-icon.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.discord2.desktop",
    "productName": "Discord2",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Discord2"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    }
  }
}
